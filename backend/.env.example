# Copy to backend/.env and fill in real values. Never commit the .env file.

SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Email
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# AWS S3 (set USE_S3=True in production)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-2
# Optional: set a CloudFront domain to serve files (leave blank to use S3 URL)
AWS_CLOUDFRONT_DOMAIN=

# Cache (Redis) — tenant-scoped caching for the IMS inventory, clinic and
# OHSMS dashboards. Set TENANT_CACHE_ENABLED=False to bypass caching.
REDIS_CACHE_URL=redis://localhost:6379/2
TENANT_CACHE_ENABLED=True
